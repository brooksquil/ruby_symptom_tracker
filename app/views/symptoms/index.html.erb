<h1>Symptoms</h1>
<%= link_to "Add Symptom", new_symptom_path %>

<h2>My custom symptoms</h2>
<ul>
  <% @custom_symptoms.each do |symptom| %>
    <li>
      <%= symptom.name %>
      <%= link_to "Edit", edit_symptom_path(symptom) %>
      <%= link_to "Delete", symptom_path(symptom), data: { turbo_method: :delete, turbo_confirm: "Delete this symptom?" } %>
    </li>
  <% end %>
</ul>

<h2>Common symptoms</h2>
<ul>
  <% @global_symptoms.each do |symptom| %>
    <li><%= symptom.name %></li>
  <% end %>
</ul>
<%= link_to "Back to Dashboard", root_path %>